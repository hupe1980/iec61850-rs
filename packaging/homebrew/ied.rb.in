# Generated by scripts/release/formula.sh for ied @VERSION@; do not edit.
class Ied < Formula
  desc "IEC 61850 command line: GOOSE, Sampled Values, MMS client and server, SCL"
  homepage "https://hupe1980.github.io/iec61850-rs/"
  version "@VERSION@"
  license any_of: ["MIT", "Apache-2.0"]

  on_macos do
    on_arm do
      url "https://github.com/hupe1980/iec61850-rs/releases/download/v@VERSION@/ied-v@VERSION@-aarch64-apple-darwin.tar.gz"
      sha256 "@SHA256_aarch64-apple-darwin@"
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/hupe1980/iec61850-rs/releases/download/v@VERSION@/ied-v@VERSION@-aarch64-unknown-linux-gnu.tar.gz"
      sha256 "@SHA256_aarch64-unknown-linux-gnu@"
    end
    on_intel do
      url "https://github.com/hupe1980/iec61850-rs/releases/download/v@VERSION@/ied-v@VERSION@-x86_64-unknown-linux-gnu.tar.gz"
      sha256 "@SHA256_x86_64-unknown-linux-gnu@"
    end
  end

  def install
    bin.install "ied"
  end

  def caveats
    on_macos do
      <<~EOS
        Capture files and MMS need no privileges. Live GOOSE/SV (`--iface`) reads and
        writes BPF devices: install Wireshark's ChmodBPF helper, or run with sudo.
      EOS
    end
    on_linux do
      <<~EOS
        Capture files and MMS need no privileges. Live GOOSE/SV (`--iface`) needs raw
        sockets; grant them to this binary once:
          sudo setcap cap_net_raw+ep #{opt_bin}/ied
        `ied` drops the capability as soon as the interface is open.
      EOS
    end
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/ied --version")
    assert_match "USAGE", shell_output("#{bin}/ied mu --help")
  end
end
